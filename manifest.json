{
  "manifest_version": 3,
  "name": "Anteater",
  "version": "0.5.1",
  "update_url": "https://d2qlgxmjkkk61q.cloudfront.net/anteater/updates.xml",
  "description": "Capture a bug and send it to the Digital team.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://hooks.zapier.com/hooks/catch/3293040/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Anteater: report a bug",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
